{
  "name": "llm-watchdog",
  "version": "0.1.1",
  "description": "Lightweight, non-blocking telemetry SDK for LLM API dependency and output monitoring",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "homepage": "https://llm-watchdog-web.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shafiquhh/LLM-Watchdog.git"
  },
  "bugs": {
    "url": "https://github.com/Shafiquhh/LLM-Watchdog/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "tsx test/sdk.test.ts",
    "prepublishOnly": "tsc"
  },
  "keywords": [
    "llm",
    "monitoring",
    "openai",
    "gemini",
    "anthropic",
    "telemetry",
    "observability",
    "p95",
    "latency"
  ],
  "author": "Shafiq",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^20.17.0",
    "tsx": "^4.23.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
