{
  "name": "llm-watchdog",
  "version": "0.1.0",
  "description": "Lightweight, non-blocking telemetry SDK for LLM API dependency and output monitoring",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist"
  },
  "keywords": [
    "llm",
    "monitoring",
    "openai",
    "anthropic",
    "telemetry",
    "observability",
    "p95",
    "latency"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^20.17.0"
  }
}
